<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <EnablePackageValidation>false</EnablePackageValidation>
        <!-- TODO (v7): remove when a later CMS 19 / SDK 11 release fixes compression of StaticAssets -->
        <!-- Compressing all CMS static assets at build time fails on SDK 11.0.100 GA too (ApplyCompressionNegotiation finds no endpoints for CMS 19.0.0-rc1 assets). -->
        <StaticWebAssetBuildCompressAllAssets>false</StaticWebAssetBuildCompressAllAssets>
        <StaticWebAssetPublishCompressAllAssets>false</StaticWebAssetPublishCompressAllAssets>
        <RootNamespace>Umbraco.Community.BlockPreview.TestSite</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Umbraco.Cms" VersionOverride="19.0.0-rc1" />
        <PackageReference Include="Umbraco.Cms.Core" VersionOverride="19.0.0-rc1" />
        <PackageReference Include="Umbraco.Cms.StaticAssets" VersionOverride="19.0.0-rc1" />
        <PackageReference Include="Umbraco.Cms.DevelopmentMode.Backoffice" VersionOverride="19.0.0-rc1" />
        <PackageReference Include="uSync" />
        <PackageReference Include="Umbraco.Community.WorktreeDevPort" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Umbraco.Community.BlockPreview\Umbraco.Community.BlockPreview.csproj" />
    </ItemGroup>

    <!-- This is needed because unlike PackageReference, ProjectReference does not run the buildTransitive targets -->
    <Import Project="..\..\src\Umbraco.Community.BlockPreview\buildTransitive\Umbraco.Community.BlockPreview.props" />

    <ItemGroup>
        <!-- Opt-in to app-local ICU to ensure consistent globalization APIs across different platforms -->
        <PackageReference Include="Microsoft.ICU.ICU4C.Runtime" VersionOverride="72.1.0.3" />
        <RuntimeHostConfigurationOption Include="System.Globalization.AppLocalIcu" Value="72.1.0.3" Condition="$(RuntimeIdentifier.StartsWith('linux')) or $(RuntimeIdentifier.StartsWith('win')) or ('$(RuntimeIdentifier)' == '' and !$([MSBuild]::IsOSPlatform('osx')))" />
    </ItemGroup>

    <ItemGroup>
        <Folder Include="umbraco\" />
    </ItemGroup>

    <PropertyGroup>
        <!-- Razor files are needed for the backoffice to work correctly -->
        <CopyRazorGenerateFilesToPublishDirectory>true</CopyRazorGenerateFilesToPublishDirectory>
    </PropertyGroup>

    <PropertyGroup>
        <RazorCompileOnBuild>false</RazorCompileOnBuild>
        <RazorCompileOnPublish>false</RazorCompileOnPublish>
    </PropertyGroup>

</Project>
