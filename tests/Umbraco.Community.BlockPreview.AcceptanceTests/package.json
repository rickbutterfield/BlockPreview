{
  "name": "acceptancetest",
  "private": true,
  "scripts": {
    "postinstall": "node postinstall.js",
    "config": "node config.js",
    "ui": "npx playwright test --ui DefaultConfig",
    "test": "npx playwright test DefaultConfig",
    "all": "npx playwright test",
    "smokeTest": "npx playwright test DefaultConfig --grep \"@smoke\"",
    "releaseTest": "npx playwright test DefaultConfig --grep \"@release\""
  },
  "devDependencies": {
    "@playwright/test": "1.56",
    "@types/node": "^20.9.0",
    "@umbraco-cms/backoffice": "19.0.0-beta1",
    "prompt": "^1.3.0",
    "typescript": "^5.8.3",
    "wait-on": "^8.0.3"
  },
  "dependencies": {
    "@umbraco/json-models-builders": "^18.0.2",
    "@umbraco-cms/acceptance-test-helpers": "19.0.0-beta1",
    "dotenv": "^16.5.0"
  }
}
