{
  "mcpServers": {
    "umbraco-cms": {
      "command": "node",
      "args": [
        "${CLAUDE_PROJECT_DIR:-.}/scripts/mcp-launch.mjs",
        "-y",
        "@umbraco-cms/mcp-dev@17"
      ]
    },
    "playwright": {
      "command": "node",
      "args": [
        "${CLAUDE_PROJECT_DIR:-.}/scripts/mcp-launch.mjs",
        "-y",
        "@playwright/mcp@latest"
      ]
    }
  }
}
